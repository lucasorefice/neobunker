# Copy to .env.local and adjust. Only NEXT_PUBLIC_RELAY_URL matters for Phase 0.

# Relay the browser elements connect to. Phase 0 uses the public anon test relay.
# Phase 1: repoint at your self-hosted moq-relay's /anon path (see deploy/README.md):
#   NEXT_PUBLIC_RELAY_URL=https://relay.example.com/anon
NEXT_PUBLIC_RELAY_URL=https://cdn.moq.dev/anon

# Phase 2 — accounts + stream ownership:
# Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/neobunker
# Auth.js secret (generate with: openssl rand -base64 33  — or: npx auth secret).
AUTH_SECRET=

# --- Added in later phases (not used yet) ---
# Shared secret with moq-relay for signing publish/subscribe JWTs (Phase 3).
# RELAY_JWT_SECRET=
